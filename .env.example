# Public browser variables for Supabase (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
VITE_ADMIN_EMAIL=ombhurke101@gmail.com
VITE_AUTH_REDIRECT_PATH=/dashboard
VITE_API_URL=http://localhost:3001

# Private backend variables (server.js - never prefix with VITE_)
API_PORT=3001
API_HOST=127.0.0.1
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
PYTHON_BIN=python
# Absolute path to private per-site folders; defaults to backend/ml/federated/sites.
FL_DATA_ROOT=
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Optional external ML/QML model inference connector
MODEL_API_BASE_URL=
MODEL_API_TOKEN=
