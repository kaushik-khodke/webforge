# Public browser configuration. Use the publishable key; never place a secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Admin account email is public routing configuration, not an authorization secret.
VITE_ADMIN_EMAIL=ombhurke101@gmail.com

# OAuth and password reset return to this same route used by the old project.
VITE_AUTH_REDIRECT_PATH=/dashboard

# Backend only. Keep this in the ignored .env file; never prefix it with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
API_PORT=3001
API_HOST=127.0.0.1

# Set these when an inference service with approved ML/QML models is available.
# The service must accept POST /predict; see README.md for its request contract.
MODEL_API_BASE_URL=
MODEL_API_TOKEN=

# For a deployed frontend hosted on a different origin.
VITE_API_URL=
CORS_ORIGIN=
