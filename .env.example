# Public browser configuration. Use the publishable key; never place a secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Admin account email is public routing configuration, not an authorization secret.
VITE_ADMIN_EMAIL=ombhurke101@gmail.com

# OAuth and password reset return to this same route used by the old project.
VITE_AUTH_REDIRECT_PATH=/dashboard
